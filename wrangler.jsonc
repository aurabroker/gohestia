{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gohestia",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-06-10",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Limit zgłoszeń formularza (POST /api/oferta) na adres IP: 5 na 60 s.
  // `namespace_id` to dowolna liczba całkowita, unikalna w ramach konta.
  "ratelimits": [
    {
      "name": "OFERTA_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ]
}
